{
  "name": "@blue/data",
  "version": "0.0.1",
  "description": "Core data model for Blue — portable TypeScript data classes with XML serialization compatible with Java .blue files",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && pnpm build:esm && pnpm build:cjs",
    "generate:blue-x7": "node scripts/generate-blue-x7-modern-orchestra.mjs",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^4.2.0",
    "quickjs-emscripten": "^0.32.0"
  },
  "keywords": [
    "csound",
    "music",
    "composition",
    "blue",
    "audio"
  ],
  "author": "Steven Yi",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/kunstmusik/blue-electron-poc"
  }
}
