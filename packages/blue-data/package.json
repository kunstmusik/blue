{
  "name": "@blue/data",
  "version": "0.1.0",
  "description": "Core data model for Blue — portable TypeScript data classes with XML serialization compatible with Java .blue files",
  "keywords": [
    "audio",
    "blue",
    "composition",
    "csound",
    "music"
  ],
  "license": "MIT AND Apache-2.0",
  "author": "Steven Yi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunstmusik/blue.git",
    "directory": "packages/blue-data"
  },
  "files": [
    "dist",
    "examples/inspect-edit.mjs",
    "resources/blue-x7-modern/ATTRIBUTION.md",
    "resources/blue-x7-modern/provenance.json",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./test-support/audio-fixtures": {
      "node": {
        "types": "./dist/cjs/test-support/audio-fixtures.d.ts",
        "default": "./dist/cjs/test-support/audio-fixtures.js"
      },
      "import": {
        "types": "./dist/esm/test-support/audio-fixtures.d.ts",
        "default": "./dist/esm/test-support/audio-fixtures.js"
      },
      "require": {
        "types": "./dist/cjs/test-support/audio-fixtures.d.ts",
        "default": "./dist/cjs/test-support/audio-fixtures.js"
      }
    },
    "./test-support": {
      "node": {
        "types": "./dist/cjs/test-support/csd-comparison.d.ts",
        "default": "./dist/cjs/test-support/csd-comparison.js"
      },
      "import": {
        "types": "./dist/esm/test-support/csd-comparison.d.ts",
        "default": "./dist/esm/test-support/csd-comparison.js"
      },
      "require": {
        "types": "./dist/cjs/test-support/csd-comparison.d.ts",
        "default": "./dist/cjs/test-support/csd-comparison.js"
      }
    }
  },
  "publishConfig": {
    "name": "@kunstmusik/blue-data",
    "access": "public"
  },
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && vp run build:all",
    "generate:blue-x7": "node scripts/generate-blue-x7-modern-orchestra.mjs",
    "test": "vp test run",
    "test:performance": "node ../../scripts/run-performance-tests.mjs data",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^4.2.0",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
