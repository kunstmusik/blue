{
  "name": "@blue/app",
  "version": "3.0.0-beta.6",
  "description": "Blue music composition environment for Csound",
  "homepage": "https://github.com/kunstmusik/blue",
  "license": "GPL-3.0-or-later",
  "author": "Blue contributors <https://github.com/kunstmusik/blue>",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vp run typecheck:renderer && vp build",
    "manual:build": "quarto render ../../docs/manual --to html",
    "engine:build": "vp run --filter @blue/engine-native build",
    "engine:stage": "node scripts/stage-blue-engine.mjs",
    "engine:prepare": "vp run engine:build && vp run engine:stage",
    "build": "vp run engine:stage && vp run --filter @blue/data build && vp run --filter @blue/engine-client build && vp run build:main && vp run build:preload && vp run build:renderer",
    "dev": "vp run engine:prepare && vp dev",
    "osc:send": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/send-osc.mjs",
    "start": "electron .",
    "test": "vp test run --config vitest.config.mts",
    "test:browser": "vp test --config vitest.browser.config.mts --run",
    "test:browser:x7": "vp test --config vitest.browser.x7.config.mts --run",
    "verify:app-zoom": "node scripts/verify-app-zoom.mjs",
    "verify:effect-interface-scrollbars": "electron scripts/verify-effect-interface-scrollbars.cjs",
    "verify:global-history": "node scripts/verify-global-project-history.mjs",
    "verify:blueshare-session": "node scripts/verify-blueshare-session.mjs",
    "release:metadata": "node ../../scripts/release-metadata.mjs --out release-metadata.json",
    "verify:package-inputs": "node ../../scripts/verify-package-inputs.mjs",
    "verify:packaged-app": "node scripts/verify-packaged-app.mjs",
    "verify:appimage": "node scripts/verify-appimage.mjs",
    "rebuild:native": "electron-rebuild -f -w zeromq",
    "package:dir": "vp run manual:build && vp run engine:stage && vp run release:metadata && vp run verify:package-inputs && electron-builder --dir --publish never",
    "package:current": "vp run manual:build && vp run engine:stage && vp run release:metadata && vp run verify:package-inputs && electron-builder --publish never",
    "package:macos-x64": "vp run manual:build && vp run engine:stage -- --target darwin-x64 && vp run release:metadata && vp run verify:package-inputs -- --target darwin-x64 && electron-builder --mac --x64 --publish never",
    "package:macos-arm64": "vp run manual:build && vp run engine:stage -- --target darwin-arm64 && vp run release:metadata && vp run verify:package-inputs -- --target darwin-arm64 && electron-builder --mac --arm64 --publish never",
    "package:windows-x64": "vp run manual:build && vp run engine:stage -- --target win32-x64 && vp run release:metadata && vp run verify:package-inputs -- --target win32-x64 && electron-builder --win --x64 --publish never",
    "package:linux-x64": "vp run manual:build && vp run engine:stage -- --target linux-x64 && vp run release:metadata && vp run verify:package-inputs -- --target linux-x64 && electron-builder --linux --x64 --publish never",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "release:manifest": "node ../../scripts/release-artifact-manifest.mjs generate --out release/release-manifest.json --release-dir release",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "test:performance": "node ../../scripts/run-performance-tests.mjs node",
    "test:performance:browser": "node ../../scripts/run-performance-tests.mjs browser",
    "test:performance:engine": "node ../../scripts/run-performance-tests.mjs engine"
  },
  "dependencies": {
    "@blue/data": "workspace:*",
    "@blue/engine-client": "workspace:*",
    "@blue/java-runtime": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource/roboto": "^5.2.10",
    "@kunstmusik/codemirror-lang-csound": "1.0.4",
    "@lezer/highlight": "^1.2.3",
    "@nextjournal/lang-clojure": "^1.0.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dnd-core": "14.0.1",
    "dockview": "^5.2.0",
    "lucide-react": "^0.563.0",
    "midi-file": "1.2.4",
    "node-osc": "^11.6.0",
    "react": "^19.2.4",
    "react-arborist": "^3.5.0",
    "react-dnd-html5-backend": "14.1.0",
    "react-dom": "^19.2.4",
    "saxes": "6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zeromq": "^6.1.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@blue/engine-native": "workspace:*",
    "@electron/rebuild": "^4.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "catalog:",
    "electron": "44.9.1",
    "electron-builder": "^26.0.36",
    "jsdom": "^29.1.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.0",
    "vite": "catalog:",
    "vite-plugin-electron": "^1.0.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "catalog:"
  },
  "desktopName": "com.kunstmusik.blue.desktop",
  "productName": "Blue"
}
