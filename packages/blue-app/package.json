{
  "name": "@blue/app",
  "productName": "Blue",
  "desktopName": "com.kunstmusik.blue.desktop",
  "version": "0.0.2",
  "description": "Electron application for Blue — loads .blue files and plays via blue-engine",
  "author": "Blue contributors <https://github.com/kunstmusik/blue-electron>",
  "homepage": "https://github.com/kunstmusik/blue-electron",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "engine:build": "pnpm --filter @blue/engine-native build",
    "engine:stage": "node scripts/stage-blue-engine.mjs",
    "engine:prepare": "pnpm engine:build && pnpm engine:stage",
    "build": "pnpm engine:stage && pnpm --filter @blue/java-runtime build && pnpm --filter @blue/data build && pnpm --filter @blue/engine-client build && pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "dev": "pnpm engine:prepare && vite",
    "osc:send": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/send-osc.mjs",
    "start": "electron .",
    "test": "vitest run --config vitest.config.ts",
    "test:browser:x7": "vitest --config vitest.browser.x7.config.ts --run",
    "verify:app-zoom": "node scripts/verify-app-zoom.mjs",
    "release:metadata": "node ../../scripts/release-metadata.mjs --out release-metadata.json",
    "verify:package-inputs": "node ../../scripts/verify-package-inputs.mjs",
    "verify:packaged-app": "node scripts/verify-packaged-app.mjs",
    "verify:appimage": "node scripts/verify-appimage.mjs",
    "rebuild:native": "electron-rebuild -f -w zeromq",
    "package:dir": "pnpm engine:stage && pnpm release:metadata && pnpm verify:package-inputs && electron-builder --dir --publish never",
    "package:current": "pnpm engine:stage && pnpm release:metadata && pnpm verify:package-inputs && electron-builder --publish never",
    "package:macos-x64": "pnpm engine:stage -- --target darwin-x64 && pnpm release:metadata && pnpm verify:package-inputs -- --target darwin-x64 && electron-builder --mac --x64 --publish never",
    "package:macos-arm64": "pnpm engine:stage -- --target darwin-arm64 && pnpm release:metadata && pnpm verify:package-inputs -- --target darwin-arm64 && electron-builder --mac --arm64 --publish never",
    "package:windows-x64": "pnpm engine:stage -- --target win32-x64 && pnpm release:metadata && pnpm verify:package-inputs -- --target win32-x64 && electron-builder --win --x64 --publish never",
    "package:linux-x64": "pnpm engine:stage -- --target linux-x64 && pnpm release:metadata && pnpm verify:package-inputs -- --target linux-x64 && electron-builder --linux --x64 --publish never",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "release:manifest": "node ../../scripts/release-artifact-manifest.mjs generate --out release/release-manifest.json --release-dir release"
  },
  "dependencies": {
    "@blue/data": "workspace:*",
    "@blue/engine-client": "workspace:*",
    "@blue/java-runtime": "workspace:*",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource/roboto": "^5.2.10",
    "@kunstmusik/codemirror-lang-csound": "^1.0.2",
    "@lezer/highlight": "^1.2.3",
    "@nextjournal/lang-clojure": "^1.0.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dnd-core": "14.0.1",
    "dockview": "^5.2.0",
    "lucide-react": "^0.563.0",
    "midi-file": "1.2.4",
    "node-osc": "^11.6.0",
    "react": "^19.2.4",
    "react-arborist": "^3.5.0",
    "react-dnd-html5-backend": "14.1.0",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zeromq": "^6.1.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@blue/engine-native": "workspace:*",
    "@electron/rebuild": "^4.0.1",
    "@electron/remote": "^2.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^4.1.6",
    "autoprefixer": "^10.4.23",
    "electron": "35.7.5",
    "electron-builder": "^26.0.36",
    "jsdom": "^29.1.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.0",
    "vite": "^7.3.2",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.6"
  }
}
