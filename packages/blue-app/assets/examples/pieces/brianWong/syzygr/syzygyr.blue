      <instrument type='blue.orchestra.GenericInstrument'>
        <name>sd.wav</name>
        <comment></comment>
        <globalOrc></globalOrc>
        <globalSco>f2 0 0 1 &quot;sd.wav&quot; 0 0 0</globalSco>
        <instrumentText>a0 	loscil3	 ampdbfs(p5), p4, 2, 1, 0
