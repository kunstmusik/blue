{
  "name": "blue-cli",
  "version": "0.1.0-beta.1",
  "description": "Node CLI for compiling Blue projects to Csound CSD output.",
  "keywords": [
    "blue",
    "cli",
    "csound"
  ],
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "author": "Steven Yi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunstmusik/blue.git",
    "directory": "packages/blue-cli"
  },
  "bin": {
    "blue-cli": "./dist/blue-cli.cjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "commonjs",
  "main": "./dist/blue-cli.cjs",
  "publishConfig": {
    "name": "@kunstmusik/blue-cli",
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "vp run build",
    "test": "vp run build && vp test run"
  },
  "dependencies": {
    "quickjs-emscripten": "^0.32.0",
    "zeromq": "^6.8.0"
  },
  "devDependencies": {
    "@blue/data": "workspace:*",
    "@blue/java-runtime": "workspace:*",
    "commander": "^14.0.3",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  },
  "//": "The bundled CLI externalizes quickjs-emscripten and zeromq. Both must remain runtime dependencies for standalone installations."
}
