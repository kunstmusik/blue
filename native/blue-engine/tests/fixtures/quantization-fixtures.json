{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Cross-language differential test fixtures for Blue automation line quantization matching Java BigDecimal FLOOR behavior",
  "fixtures": [
    {
      "name": "positive_scale1_res01_ascending",
      "value": 0.12345,
      "resolution": 0.1,
      "resolutionScale": 1,
      "isDescending": false,
      "expectedHighPrecision": 0.1,
      "expectedFast": 0.1
    },
    {
      "name": "positive_scale1_res01_descending",
      "value": 0.12345,
      "resolution": 0.1,
      "resolutionScale": 1,
      "isDescending": true,
      "expectedHighPrecision": 0.2,
      "expectedFast": 0.2
    },
    {
      "name": "positive_scale2_res001_ascending",
      "value": 0.4567,
      "resolution": 0.01,
      "resolutionScale": 2,
      "isDescending": false,
      "expectedHighPrecision": 0.45,
      "expectedFast": 0.45
    },
    {
      "name": "positive_scale2_res001_descending",
      "value": 0.4567,
      "resolution": 0.01,
      "resolutionScale": 2,
      "isDescending": true,
      "expectedHighPrecision": 0.46,
      "expectedFast": 0.46
    },
    {
      "name": "positive_scale2_res025_ascending",
      "value": 0.74,
      "resolution": 0.25,
      "resolutionScale": 2,
      "isDescending": false,
      "expectedHighPrecision": 0.5,
      "expectedFast": 0.5
    },
    {
      "name": "positive_scale2_res025_descending",
      "value": 0.74,
      "resolution": 0.25,
      "resolutionScale": 2,
      "isDescending": true,
      "expectedHighPrecision": 0.75,
      "expectedFast": 0.75
    },
    {
      "name": "negative_scale1_res01_ascending",
      "value": -0.12345,
      "resolution": 0.1,
      "resolutionScale": 1,
      "isDescending": false,
      "expectedHighPrecision": -0.2,
      "expectedFast": -0.2
    },
    {
      "name": "negative_scale1_res01_descending",
      "value": -0.12345,
      "resolution": 0.1,
      "resolutionScale": 1,
      "isDescending": true,
      "expectedHighPrecision": -0.1,
      "expectedFast": -0.1
    },
    {
      "name": "negative_scale2_res001_ascending",
      "value": -0.4567,
      "resolution": 0.01,
      "resolutionScale": 2,
      "isDescending": false,
      "expectedHighPrecision": -0.46,
      "expectedFast": -0.46
    },
    {
      "name": "negative_scale2_res001_descending",
      "value": -0.4567,
      "resolution": 0.01,
      "resolutionScale": 2,
      "isDescending": true,
      "expectedHighPrecision": -0.45,
      "expectedFast": -0.45
    },
    {
      "name": "boundary_exact_step_ascending",
      "value": 0.5,
      "resolution": 0.1,
      "resolutionScale": 1,
      "isDescending": false,
      "expectedHighPrecision": 0.5,
      "expectedFast": 0.5
    },
    {
      "name": "boundary_exact_step_descending",
      "value": 0.5,
      "resolution": 0.1,
      "resolutionScale": 1,
      "isDescending": true,
      "expectedHighPrecision": 0.5,
      "expectedFast": 0.5
    },
    {
      "name": "boundary_just_below_ascending",
      "value": 0.4999999,
      "resolution": 0.1,
      "resolutionScale": 1,
      "isDescending": false,
      "expectedHighPrecision": 0.4,
      "expectedFast": 0.4
    },
    {
      "name": "boundary_just_below_descending",
      "value": 0.4999999,
      "resolution": 0.1,
      "resolutionScale": 1,
      "isDescending": true,
      "expectedHighPrecision": 0.5,
      "expectedFast": 0.5
    },
    {
      "name": "zero_ascending",
      "value": 0.0,
      "resolution": 0.1,
      "resolutionScale": 1,
      "isDescending": false,
      "expectedHighPrecision": 0.0,
      "expectedFast": 0.0
    },
    {
      "name": "zero_descending",
      "value": 0.0,
      "resolution": 0.1,
      "resolutionScale": 1,
      "isDescending": true,
      "expectedHighPrecision": 0.0,
      "expectedFast": 0.0
    },
    {
      "name": "integer_scale0_res1_ascending",
      "value": 4.8,
      "resolution": 1.0,
      "resolutionScale": 0,
      "isDescending": false,
      "expectedHighPrecision": 4.0,
      "expectedFast": 4.0
    },
    {
      "name": "integer_scale0_res1_descending",
      "value": 4.8,
      "resolution": 1.0,
      "resolutionScale": 0,
      "isDescending": true,
      "expectedHighPrecision": 5.0,
      "expectedFast": 5.0
    },
    {
      "name": "integer_scale0_res5_ascending",
      "value": 13.2,
      "resolution": 5.0,
      "resolutionScale": 0,
      "isDescending": false,
      "expectedHighPrecision": 10.0,
      "expectedFast": 10.0
    },
    {
      "name": "integer_scale0_res5_descending",
      "value": 13.2,
      "resolution": 5.0,
      "resolutionScale": 0,
      "isDescending": true,
      "expectedHighPrecision": 15.0,
      "expectedFast": 15.0
    }
  ]
}
