{
  "name": "blue-electron-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "app:build": "pnpm --filter @blue/app build && pnpm --filter @blue/app package:dir",
    "app:package": "pnpm --filter @blue/app package:current",
    "clean": "node scripts/clean.mjs",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "audit:renderer-theme": "node scripts/audit-renderer-theme.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:package-inputs": "node scripts/verify-package-inputs.mjs",
    "verify:release-workflows": "node scripts/validate-release-workflows.mjs",
    "verify:release-credentials": "node scripts/release-credential-preflight.test.mjs",
    "release:preflight": "node scripts/release-credential-preflight.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.4"
  }
}
