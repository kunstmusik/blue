kBlueX7CoordinatorChanged changed gk_blue_auto152, gk_blue_auto157, gk_blue_auto158, gk_blue_auto186, gk_blue_auto191, gk_blue_auto208, gk_blue_auto213, gk_blue_auto230, gk_blue_auto235, gk_blue_auto252, gk_blue_auto257, gk_blue_auto274, gk_blue_auto279, gk_blue_auto296, gk_blue_auto301
